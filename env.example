# MINAS environment variables
# Copy to .env and fill in before running

# Ollama (local inference server)
OLLAMA_URL=http://localhost:11434

# LLM model — must be pulled/registered first via Ollama.
#
# Default: qwen2.5:7b — chosen 2026-09-12 after the OTel-LLM-E4B-IT default
# (see below) failed a live smoke test: it never attempted a single tool
# call, abstaining immediately with "Answer not found in the retrieved
# context." llama3.1:8b was also tried and rejected: it emits tool calls as
# plain text instead of Ollama's structured tool_calls field, so react.py
# never recognises them. qwen2.5:7b was the only one of the three that
# reliably drove the ReAct loop end-to-end (record_intent -> cn_nssmf_*/
# ran_nssmf_* -> update_intent_status) across several live runs.
#   ollama pull qwen2.5:7b
#
# No telecom fine-tuning, so domain-hallucination mitigation rests entirely
# on agents/guardrails.py (deterministic validation), not the model itself.
# This is informal, single-run evidence, not the rigorous benchmark the
# TCC I text promises (comparing candidates on a TS 28.312-derived intent
# set, measuring tool-calling accuracy) — that benchmark is still open work.
#
# --- Why NOT OTel-LLM-E4B-IT (or any other size in the OTel-LLM family) ---
#
# OTel-LLM-E4B-IT (AT&T/OTel, Gemma-based; "E4B" is a MatFormer *effective*-
# parameter label, not the on-disk size — the HF repo ships ~8B raw params as
# fp32 pytorch shards, ~31.5GB download, ~5GB once quantized to Q4_K_M) is
# fine-tuned on 3GPP/O-RAN specs and scored 91.7% correctness on OTel's own
# "context-grounded generation" eval — the best published result in that
# category. It looked like the obvious pick for MINAS's domain.
#
# It doesn't work here because every model in the OTel-LLM family is trained
# on the same recipe: question + retrieved context chunk + answer, PLUS
# abstention examples for when the context doesn't contain the answer. MINAS
# has no RAG yet (pending item P3 — inject TS 28.312/23.288 chunks before the
# ReAct loop), so the model never sees a context block shaped like its
# training data, and its trained reflex is to abstain rather than attempt a
# tool call. This isn't fixable by prompting around it — it's the training
# recipe, and it's shared by every OTel-LLM-*-IT size, not just E4B. The
# model card also confirms the mixture has no telecom-specific MCP/tool-
# calling examples, compounding the problem.
# Revisit once P3 (RAG) exists — feeding it a real retrieved-context block
# may unlock its intended behavior; until then it cannot drive the ReAct loop
# at all, not just "worse than qwen" but non-functional.
#
# Kept below for when that day comes — conversion needs ~70GB of free disk
# temporarily (31.5GB download + ~16GB f16 intermediate + ~5GB final quant —
# delete the first two once quantized):
#
#   pip install -U "huggingface_hub[cli]"   # provides the `hf` command
#   hf download farbodtavakkoli/OTel-LLM-E4B-IT --local-dir otel-e4b
#   git clone https://github.com/ggml-org/llama.cpp
#   pip install -r llama.cpp/requirements/requirements-convert_hf_to_gguf.txt
#   python llama.cpp/convert_hf_to_gguf.py otel-e4b --outfile otel-e4b-f16.gguf --outtype f16
#   # llama-quantize is a compiled binary — grab a prebuilt release instead of
#   # building from source: https://github.com/ggml-org/llama.cpp/releases
#   # (look for llama-<tag>-bin-win-cpu-x64.zip, or -cuda-... if you have an
#   # NVIDIA GPU; quantizing itself is CPU-only either way)
#   ./llama-quantize otel-e4b-f16.gguf otel-e4b-q4_k_m.gguf Q4_K_M
#   ollama create otel-llm-e4b-it -f - <<'EOF'
#   FROM ./otel-e4b-q4_k_m.gguf
#   EOF
#   MINAS_MODEL=otel-llm-e4b-it
#
# (convert_hf_to_gguf.py does NOT accept q4_k_m directly — only f32/f16/bf16/
# q8_0/tq1_0/tq2_0/auto — hence the separate quantize step above. `huggingface-
# cli` is deprecated in favor of `hf`, same flags. The OTel repo also lists
# Ollama-compatible pre-built quantizations under its `inference/ollama`
# recipe — check there first, it may skip all of this.)
#
# KNOWN GOTCHAS when converting this specific checkpoint on Windows (hit and
# fixed locally while setting this up — not upstream bugs, just what this
# model + toolchain combo needs):
#   1. torch.load(..., mmap=True) on the 11GB shard raises
#      `OSError: [Errno 22] Invalid argument` — a Windows-only mmap/offset-
#      alignment issue in PyTorch for large sharded checkpoints. Fix: in your
#      llama.cpp checkout, wrap the torch.load call in
#      conversion/base.py (~line 267, inside index_tensors) in a
#      try/except OSError that retries with mmap=False.
#   2. The checkpoint's tokenizer_config.json ships
#      "extra_special_tokens": ["<|video|>"] (a list) but the installed
#      `transformers` expects a dict there, raising
#      `AttributeError: 'list' object has no attribute 'keys'`. Fix: edit
#      your local copy of tokenizer_config.json and set
#      "extra_special_tokens": {} before converting (safe — it only drops an
#      unused multimodal special token, irrelevant for this text-only use).
#
# Generic fallback (larger, no telecom fine-tuning, needs ~40GB+ RAM/VRAM):
#   ollama pull llama3.1:70b
#   MINAS_MODEL=llama3.1:70b
MINAS_MODEL=qwen2.5:7b

# PostgreSQL (matches docker-compose.yml defaults)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=minas
POSTGRES_USER=minas
POSTGRES_PASSWORD=minas

# Domain agent URLs (matches docker-compose service names)
CN_NSSMF_URL=http://cn-nssmf:8001
RAN_NSSMF_URL=http://ran-nssmf:8002

# RQ3 ablation switches for the systematic benchmark (TCC-II-DRAFT.tex
# Section 5: factorial design over model x RAG x guardrails). Both default to
# "true" — set to "false" to run a cell of the ablation with that layer off.
# RAG_ENABLED=false skips retrieval entirely; the ReAct loop gets the raw
# intent with no context block. GUARDRAILS_ENABLED=false still runs every
# validator and logs what it would have rejected, but returns the tool call's
# real result instead of the guardrail error, so its effect on hallucinated/
# invalid actions can be measured against the enabled condition.
RAG_ENABLED=true
GUARDRAILS_ENABLED=true

# Reproducibility of LLM runs (agents/react.py). Unset = Ollama defaults
# (sampled, varies run to run — how every benchmark before 2026-09-28 ran).
# Set both for deterministic-as-possible runs, e.g. MINAS_TEMPERATURE=0 MINAS_SEED=42.
MINAS_TEMPERATURE=
MINAS_SEED=

# Guardrail ceiling for any bit rate a tool may request (Mbps). Default = the
# 1 Gbps Session-AMBR provisioned in scripts/provision.js.
GUARDRAIL_MAX_RATE_MBPS=1000

# KPI collector sources (agents/collector/main.py).
#   Mocked dev stack (no Open5GS/Prometheus up): CORE_SOURCE=mock, otherwise
#   every core sample fails and core_kpis silently stops growing — the NWDAF
#   then answers "stale history" instead of predicting.
#   Lab / real core: CORE_SOURCE=prometheus (per-slice throughput comes from
#   the upf-netdev exporter's ogstun/ogstun2 counters, mapped by SLICE_TUN).
CORE_SOURCE=prometheus
RAN_SOURCE=mock
SLICE_TUN=1:ogstun,2:ogstun2

# NWDAF: refuse to predict when the newest core_kpis sample is older than this.
NWDAF_MAX_STALENESS_S=120

# Operator time zone (agents/timeutil.py): the orchestrator tells the LLM the
# current date/time in this zone, and timestamps without an offset are read in
# it (not UTC). Intents whose window starts more than ACTIVATION_GRACE_SECONDS
# ahead are stored as 'scheduled' and applied by the scheduler at window_start.
MINAS_TZ=America/Sao_Paulo
ACTIVATION_GRACE_SECONDS=60

# Collector: CORE_SOURCE/RAN_SOURCE=synthetic gives per-slice series WITH
# temporal structure (agents/collector/synth.py: diurnal + AR(1) + bursts) —
# use it instead of mock whenever something learns from the data (NWDAF, UC1).
# For RQ4 history, backfill a dedicated database instead of waiting:
#   agents/collector/backfill_synthetic.py (see its docstring).
SYNTH_SEED=0

# Use Case 1 — proactive monitor in the CN-NSSMF (agents/cn-nssmf/monitor.py):
# every UC1_POLL_SECONDS it compares the NWDAF prediction with the guarantee
# of the newest windowless in-force intent on each slice in UC1_SLICES and,
# above UC1_MARGIN, reports to the orchestrator (POST /event), which scales
# the slice to prediction x (1 + UC1_HEADROOM).
# Set UC1_ENABLED=false for LLM benchmark runs (events would add LLM calls
# in the middle of the measurements).
UC1_ENABLED=true
UC1_POLL_SECONDS=30
UC1_SLICES=2
UC1_MARGIN=0.10
UC1_COOLDOWN_SECONDS=300
UC1_HEADROOM=0.10

# SLA monitor in the orchestrator (agents/orchestrator/sla_monitor.py): one
# sla_samples row per in-force intent every SLA_SAMPLE_SECONDS; an
# sla_violation event after SLA_VIOLATION_STREAK non-compliant samples in a
# row. Report: agents/benchmark/sla_report.py. Also off for LLM benchmarks.
SLA_MONITOR_ENABLED=true
SLA_SAMPLE_SECONDS=30
SLA_VIOLATION_STREAK=3

# LLM context window / generation cap / request timeout (agents/react.py),
# always sent to Ollama. Its default 4096-token context overflowed on ~3% of
# calls in the 2026-09-28 benchmark (Ollama silently drops the oldest half —
# possibly the system prompt), and uncapped generation hit the timeout.
MINAS_NUM_CTX=8192
MINAS_NUM_PREDICT=1024
OLLAMA_TIMEOUT_SECONDS=180
