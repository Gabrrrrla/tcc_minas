# environment — nunca commitar
.env
.env.example

# Claude Code
.claude/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Logs
*.log
*.pcap

# Benchmark run output (agents/benchmark/run_benchmark.py) — raw per-run data,
# not source; regenerate via the runner rather than versioning it.
agents/benchmark/results/
!agents/benchmark/results/**/*.jsonl

# Texto
*.txt
*.md
*.tex
# exceções: versionados mesmo com as regras acima (README traz o apêndice do TCC)
!README.md
!docs/figures/
!agents/benchmark/plots.py

# Docs
*.pdf
# Pastas do texto do TCC I e II (locais, não versionadas)
tcc1/
tcc2/

# lab runs (scripts/lab_collect.sh)
lab-data/
!lab-data/
!lab-data/*/
!lab-data/*/probe/
!lab-data/*/probe/*.jsonl

# lab: configs do gNB do Miguel (hardware do lab) e SIMs reais
gnb_ru_liteon*.yml
srsran/gnb.lab.yaml

# lab: credenciais reais dos chips (scripts/provision.lab.js carrega)
scripts/sims.lab.js
